# Copy this file to .env and adjust as needed. .env is git-ignored.

# Application under test
BASE_URL=https://freelance-learn-automation.vercel.app

# Backend the app calls (used by the API specs and the AuthApi helper)
API_BASE_URL=https://learn-automation.onrender.com

# Shared account used by every test that just needs "a signed-in user".
# Leave unset to fall back to test-data/users.json.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# debug | info | warn | error
LOG_LEVEL=info
