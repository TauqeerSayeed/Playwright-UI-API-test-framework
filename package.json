{
  "name": "learn-automation-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright UI + API test framework for the Learn Automation Courses app, built on the Page Object Model with JSON-driven test data, HTML and Allure reporting.",
  "type": "commonjs",
  "private": true,
  "keywords": [
    "playwright",
    "page-object-model",
    "test-automation",
    "allure",
    "javascript"
  ],
  "license": "ISC",
  "scripts": {
    "test": "playwright test --project=setup --project=chromium --project=auth-chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test tests/api --project=chromium",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:auth": "playwright test tests/auth --project=auth-chromium",
    "test:cart": "playwright test tests/cart",
    "test:cross-browser": "playwright test --project=setup --project=chromium --project=firefox --project=webkit",
    "test:mobile": "playwright test --project=setup --project=mobile-chrome",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report:allure": "npm run allure:generate && npm run allure:open",
    "clean": "node -e \"['test-results','playwright-report','allure-results','allure-report'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "pretest": "npm run clean",
    "codegen": "playwright codegen https://freelance-learn-automation.vercel.app/login",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "dotenv": "^17.4.2"
  }
}
